# ---------------------------------------------------------------------------
# One .env at the repository root serves all three packages: the API loads it
# with --env-file-if-exists, the batch command loads it explicitly, and the web
# app loads it from next.config.ts.
#
# To get running you need three things: GEMINI_API_KEY, MONGODB_URI and
# AUTH_SECRET. Everything else has a working default.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Language model. Gemini is the default because its free tier has the most
# usable tokens-per-minute budget. Any OpenAI-compatible endpoint works too.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Required when LLM_PROVIDER=gemini. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required instead when LLM_PROVIDER is an OpenAI-compatible service (groq, openrouter, ...)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Client-side throttling, so a free tier is never the reason a run fails.
# Free tiers cap tokens per minute as well as requests; both are tracked.
LLM_REQUESTS_PER_MINUTE=10
LLM_TOKENS_PER_MINUTE=200000
LLM_CONCURRENCY=2
LLM_MAX_ATTEMPTS=4


# ---------------------------------------------------------------------------
# Web search for public discussion of a company's interview process.
# All optional: with no key the app falls back to DuckDuckGo's HTML endpoint
# and reports honestly when nothing is found.
# Set SEARCH_PROVIDER=none to skip the search step entirely.
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=
BRAVE_API_KEY=
TAVILY_API_KEY=


# ---------------------------------------------------------------------------
# Retrieval limits. ALLOW_PRIVATE_URLS must stay unset (or false) in
# production: it is what stops a submitted URL reaching internal addresses.
# Batch runs against a local fixture site need it set to true.
# ---------------------------------------------------------------------------
ALLOW_PRIVATE_URLS=
FETCH_TIMEOUT_MS=12000
FETCH_MAX_BYTES=2000000
CRAWL_MAX_PAGES=12


# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Connection string. MongoDB Atlas free tier is fine.
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit

# Verifies the short-lived token the web server sends with each forwarded
# request, and signs the API's own session cookie. At least 16 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=

SESSION_TTL_DAYS=7

# Comma separated browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:3000

# How many kits may generate at the same time on this instance.
GENERATION_CONCURRENCY=2

# Set to true when the API sits behind a proxy that terminates TLS, so rate
# limiting sees the real client address. Implied by NODE_ENV=production.
TRUST_PROXY=

# Abuse limits. These are the production values; the test suite raises them.
AUTH_ATTEMPTS_PER_WINDOW=20
API_REQUESTS_PER_MINUTE=300


# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# Where the web app forwards /backend/* requests. Server-side only, so it is
# never exposed to the browser.
API_ORIGIN=http://localhost:4000

# Signs and encrypts the NextAuth session cookie.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Must match the API's JWT_SECRET above. The web server signs a five-minute
# token with it when it forwards a request on a signed-in user's behalf.
API_JWT_SECRET=
